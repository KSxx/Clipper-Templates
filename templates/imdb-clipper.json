{
	"schemaVersion": "0.1.0",
	"name": "IMDb – KSxx",
	"behavior": "create",
	"noteNameFormat": "{{schema:name}} ({% if schema:@TVSeries:name %}{{title|replace:\"/^.*?([0-9]{4}).*$/\":\"$1\"}}{% else %}{{schema:datePublished|split:\"-\"|slice:0,1}}{% endif %})",
	"path": "Clippings",
	"noteContentFormat": "![{{schema:name}}]({{schema:image}})\n\n## Handlung\n\n{{selector:[data-testid=\"plot-xl\"]|first}}\n\n## Verfügbarkeit\n\n[Bei WerStreamt.es prüfen](https://www.werstreamt.es/filme-serien/?q={{schema:name|replace:\" \":\"%20\"}}&action_results=suchen)",
	"properties": [
		{
			"name": "type",
			"value": "{% if schema:@TVSeries:name %}series{% else %}movie{% endif %}",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{schema:name}}",
			"type": "text"
		},
		{
			"name": "year",
			"value": "{% if schema:@TVSeries:name %}{{title|replace:\"/^.*?([0-9]{4}).*$/\":\"$1\"}}{% else %}{{schema:datePublished|split:\"-\"|slice:0,1}}{% endif %}",
			"type": "number"
		},
		{
			"name": "genres",
			"value": "{{schema:genre|join}}",
			"type": "multitext"
		},
		{
			"name": "directors",
			"value": "{% if schema:@TVSeries:name %}{% else %}{{schema:director[*].name|join}}{% endif %}",
			"type": "multitext"
		},
		{
			"name": "creators",
			"value": "{% if schema:@TVSeries:name %}{{selector:[data-testid=\"title-pc-principal-credit\"]:first-child a|unique|join}}{% endif %}",
			"type": "multitext"
		},
		{
			"name": "cast",
			"value": "{{schema:actor[*].name|slice:0,3|join}}",
			"type": "multitext"
		},
		{
			"name": "imdb-rating",
			"value": "{{schema:aggregateRating.ratingValue}}",
			"type": "number"
		},
		{
			"name": "rating",
			"value": "",
			"type": "number"
		},
		{
			"name": "cover",
			"value": "{{schema:image}}",
			"type": "text"
		},
		{
			"name": "source-url",
			"value": "{{url|split:\"?\"|first}}",
			"type": "text"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "tags",
			"value": "{% if schema:@TVSeries:name %}serie{% else %}film{% endif %}",
			"type": "multitext"
		},
		{
			"name": "aliases",
			"value": "",
			"type": "multitext"
		},
		{
			"name": "related",
			"value": "",
			"type": "multitext"
		}
	],
	"triggers": [
		"/^https:\\/\\/www\\.imdb\\.com\\/(?:[a-z]{2}\\/)?title\\/tt\\d+(?!\\/reference\\/)(\\/[^\\s]*)?$/"
	]
}
