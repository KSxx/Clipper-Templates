{
	"schemaVersion": "0.1.0",
	"name": "Wikipedia",
	"behavior": "create",
	"noteNameFormat": "{{title}}",
	"path": "Clippings",
	"noteContentFormat": "{% if selection %}\n{{selectionHtml|remove_html:(\"sup,img,.mw-editsection\")|markdown}}\n{% else %}\n{{contentHtml|remove_html:(\"img,sup,.mw-editsection,section:has(ol.references),.mw-heading:has(~ ol.references),.mw-references-wrap,.reflist,ol.references\")|markdown}}\n{% endif %}",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "Wikipedia",
			"type": "text"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clippings, wikipedia",
			"type": "multitext"
		}
	],
	"triggers": [
		"/^https:\\/\\/[a-z-.]+\\.wikipedia\\.org\\/wiki\\/.*$/"
	]
}
